{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run TTS Custom PATH",
            "type": "shell",
            "command": "${command:cmake.launchTargetPath}",
            "args": [],
            "options": {
                "cwd": "${command:cmake.buildDirectory}/${command:cmake.buildType}",
                "env": {
                    "PATH": "${command:cmake.buildDirectory}/deps/dist/bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
} 